#!/usr/bin/env bash
# commit-msg hook: 拒绝包含 "claude" 关键词的提交信息

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

if echo "$MSG" | grep -iq "claude"; then
    echo "ERROR: Commit message contains 'claude' which is not allowed."
    echo "Please remove any claude-related content and try again."
    exit 1
fi

exit 0
